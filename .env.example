# OnShape API Configuration (if using environment variables)
PUBLIC_ONSHAPE_ACCESS_KEY=your_onshape_access_key
PUBLIC_ONSHAPE_SECRET_KEY=your_onshape_secret_key
PUBLIC_ONSHAPE_BASE_URL=https://cad.onshape.com

# Supabase Configuration
PUBLIC_SUPABASE_URL=your_supabase_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# The Blue Alliance API (server-side only)
TBA_API_KEY=your_tba_api_key

# Demo mode flag (server-side only)
# When true, include finished matches in "upcoming" and allow testing past events.
# Accepted truthy values: "true", "1", "yes", "y"
# Use CEMO (preferred). Lowercase "cemo" is also supported.
CEMO=false
